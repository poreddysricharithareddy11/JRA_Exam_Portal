NODE_ENV=production
PORT=3000
PORTAL_NAME=Jayarama Exam Portal
# Public address of the portal; used in the assessment links e-mailed to candidates
PUBLIC_URL=https://exams.example.com
# Set to true when served over HTTPS (required in production)
COOKIE_SECURE=true
# Number of reverse proxies in front (e.g. 1 for nginx/Render/Railway)
TRUST_PROXY=1
# Optional; auto-generated and stored in DATA_DIR if empty
JWT_SECRET=
DATA_DIR=./data

ADMIN_USERNAME=jayarama_exam
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
