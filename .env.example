# ---- local development (SQLite file in ./data, no setup needed) -------------------------------
NODE_ENV=development
PORT=3000
PORTAL_NAME=Jayarama Exam Portal
PUBLIC_URL=http://localhost:3000

ADMIN_USERNAME=jayarama_exam
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=

# ---- production (free hosting) ----------------------------------------------------------------
# Postgres connection string (free Neon database). When set, the app uses Postgres instead of SQLite.
DATABASE_URL=
# Long random text. REQUIRED in production so sign-ins survive restarts (the host's disk is wiped on redeploy).
JWT_SECRET=
COOKIE_SECURE=true      # true when served over HTTPS
TRUST_PROXY=1           # number of proxies in front (Render = 1)

# ---- e-mail: result PDFs + reminders. Use ONE of the following ---------------------------------
# A) Brevo HTTPS API (free 300/day, works on free hosts). Verify the sender address in Brevo first.
BREVO_API_KEY=
MAIL_FROM=Jayarama Exam Portal <jayaramaexamportal@gmail.com>
# B) Resend HTTPS API (needs a verified domain to mail other people)
RESEND_API_KEY=
# C) SMTP (Gmail App Password). Fine on your own PC / a VPS; usually blocked on free web hosts.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
